# Conexión a tu base de datos real (Supabase, pestaña "Session pooler")
DATABASE_URL=postgresql://postgres.xxxxx:tu-password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Proveedor activo de emisión de la GRE-Transportista: demo | pse | directo
GRE_PROVIDER=demo

# --- Solo para GRE_PROVIDER=demo ---
GRE_SERIE=T001
GRE_CORRELATIVO_INICIAL=160

# --- Solo para GRE_PROVIDER=pse ---
PSE_BASE_URL=https://api.tu-pse.pe/v1
PSE_API_TOKEN=
RUC_EMISOR=20548712369

# --- Solo para GRE_PROVIDER=directo ---
SUNAT_CERTIFICADO_PATH=./certificados/produccion.pfx
SUNAT_CERTIFICADO_PASSWORD=
SUNAT_AMBIENTE=beta
