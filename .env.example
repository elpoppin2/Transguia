# Conexión a la base de datos (Supabase).
#  - En local / Render / Railway: usa la cadena "Session pooler"  (puerto 5432)
#  - En Vercel (serverless):        usa la cadena "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxx:tu-password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Secreto para firmar los tokens de sesión. Poné una cadena larga y
# aleatoria (p. ej.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" ).
# OBLIGATORIO en producción. En desarrollo, si falta, se usa uno fijo.
SESSION_SECRET=

# Puerto del servidor (los hostings como Render/Railway lo definen solos)
PORT=3001

# Proveedor activo de emisión de la GRE-Transportista: demo | pse | directo
GRE_PROVIDER=demo

# --- Solo para GRE_PROVIDER=demo ---
GRE_SERIE=T001
GRE_CORRELATIVO_INICIAL=160
# Demora simulada de la "respuesta de SUNAT", en ms. En Vercel la petición
# espera este tiempo, así que ahí conviene poco (por defecto 150 en Vercel,
# 1200 en un servidor normal).
# GRE_DEMO_DEMORA_MS=150

# Fuerza que la emisión de la GRE termine antes de responder (1) o corra en
# segundo plano (0). Si no se define, se autodetecta: síncrona en Vercel.
# EMISION_SINCRONA=1

# --- Solo para GRE_PROVIDER=pse ---
PSE_BASE_URL=https://api.tu-pse.pe/v1
PSE_API_TOKEN=
RUC_EMISOR=20548712369

# --- Solo para GRE_PROVIDER=directo ---
SUNAT_CERTIFICADO_PATH=./certificados/produccion.pfx
SUNAT_CERTIFICADO_PASSWORD=
SUNAT_AMBIENTE=beta
